/**
 * @file tasks.json
 * @description Visual Studio Code task configuration used to build
 *              TypeScript projects using the TypeScript compiler.
 *
 * @author Robin Phillis
 * @version 1.0
 * @date 2026
 */

{
    // Task configuration format version
    "version": "2.0.0",

    "tasks": [
        {
            // Specifies that this task runs the TypeScript compiler
            "type": "typescript",

            // Points to the TypeScript configuration file
            "tsconfig": "tsconfig.json",

            // Detects TypeScript compiler errors and warnings
            "problemMatcher": 
			[
                "$tsc"
            ],

            "group": 
			{
                // Marks this task as a build task
                "kind": "build",

                // Makes this the default build task
                "isDefault": true
            }
        }
    ]
}